# Copy to ERP_Backend/.env (git-ignored) for local runs. In deployed environments set real
# environment variables / secrets-manager entries instead. Never commit real values.

DB_URL=jdbc:postgresql://<host>:<port>/postgres?sslmode=require&prepareThreshold=0
DB_USERNAME=<user>
DB_PASSWORD=<password>

# At least 32 random bytes, e.g.:  openssl rand -base64 48
JWT_SECRET=<generate-me>

# AES-256 key for MFA secrets: base64 of exactly 32 random bytes, e.g.:  openssl rand -base64 32
# Changing it makes existing MFA enrollments unreadable (users must re-enroll).
MFA_ENCRYPTION_KEY=<generate-me>

# Local development conveniences (never in production)
# SWAGGER_ENABLED=true
# PASSWORD_RESET_LOG_LINKS=true

# Optional overrides (defaults shown)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# REFRESH_COOKIE_SECURE=true
# REFRESH_COOKIE_SAME_SITE=Strict
# PASSWORD_RESET_LINK_BASE=http://localhost:5173/reset-password
# PASSWORD_BREACH_CHECK_ENABLED=true
# MFA_ENFORCE_PRIVILEGED=true
# JWT_ACCESS_TTL_MS=900000
# JWT_REFRESH_TTL_MS=604800000
# APP_LOG_LEVEL=INFO
